@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var role = session?.GetString("Role");
    var fullName = session?.GetString("FullName");
    var isLoggedIn = !string.IsNullOrEmpty(role);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay South Africa</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter & Outfit for energetic sports typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/raceday.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Main Sporting Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-navy shadow-sm sticky-top border-bottom border-success-subtle">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-black text-uppercase tracking-wider" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge bg-gradient-race text-dark rounded-3 px-2 py-1 fw-bold">
                        <i class="bi bi-stopwatch-fill me-1"></i>RACE
                    </span>
                    <span class="text-white fw-extrabold">DAY</span>
                    <span class="badge bg-emerald-subtle text-emerald border border-emerald fs-xs fw-semibold ms-1">SA</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#racedayNavbar" aria-controls="racedayNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="racedayNavbar">
                    <!-- Navigation Items: Dynamic Role-Based Experience (Requirement 2 & 7) -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-light-silver fw-medium" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-calendar3-event me-1"></i> Browse Events
                            </a>
                        </li>

                        @if (role == "Organiser")
                        {
                            <!-- Organiser Navigation Menu (Requirement 3) -->
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Organiser" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Organiser Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light-silver" asp-controller="Organiser" asp-action="Events">
                                    <i class="bi bi-flag-fill me-1"></i> Manage My Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-success fw-medium" asp-controller="Organiser" asp-action="CreateEvent">
                                    <i class="bi bi-plus-circle-fill me-1"></i> Create Event
                                </a>
                            </li>
                        }
                        else if (role == "Participant")
                        {
                            <!-- Participant Navigation Menu (Requirement 4) -->
                            <li class="nav-item">
                                <a class="nav-link text-light-silver fw-medium" asp-controller="Participant" asp-action="MyEnrolments">
                                    <i class="bi bi-ticket-perforated-fill me-1"></i> My Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-medium" asp-controller="Participant" asp-action="MyResults">
                                    <i class="bi bi-trophy-fill me-1"></i> My Results & History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light-silver fw-medium" asp-controller="Participant" asp-action="Profile">
                                    <i class="bi bi-person-badge-fill me-1"></i> Athlete Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Session / Auth Controls -->
                    <div class="d-flex align-items-center gap-3">
                        @if (isLoggedIn)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(role == "Organiser" ? "bg-warning text-dark" : "bg-success text-white") text-uppercase px-2 py-1 fs-xs fw-bold">
                                    <i class="bi @(role == "Organiser" ? "bi-award-fill" : "bi-lightning-charge-fill") me-1"></i>@role
                                </span>
                                <span class="text-white-50 small d-none d-md-inline">@fullName</span>
                            </div>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                                    <i class="bi bi-box-arrow-right me-1"></i> Log Out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm px-3 rounded-pill fw-medium">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-sm px-3 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-person-plus-fill me-1"></i> Register Free
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert / Feedback Banner (Graceful feedback, Requirement 7) -->
    <main role="main" class="flex-grow-1">
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                    <div>@TempData["InfoMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark-navy text-white-50 py-4 mt-5 border-top border-secondary-subtle">
        <div class="container text-center text-md-start">
            <div class="row align-items-center gy-3">
                <div class="col-md-6">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="brand-badge bg-gradient-race text-dark rounded-2 px-2 py-0 fw-bold fs-sm">RACE</span>
                        <strong class="text-white">DAY SOUTH AFRICA</strong>
                        <span class="badge bg-secondary fs-xs">Part 3 Final Release</span>
                    </div>
                    <small>Official Sports Timing, Event Registration &amp; Cloud Asset Management Platform.</small>
                </div>
                <div class="col-md-6 text-center text-md-end small">
                    <span class="me-3"><i class="bi bi-shield-check text-success me-1"></i> Azure Blob Storage Enabled</span>
                    <span><i class="bi bi-box-seam text-info me-1"></i> Docker Containerised</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
