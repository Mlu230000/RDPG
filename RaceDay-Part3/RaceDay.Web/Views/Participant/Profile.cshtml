@model RaceDay.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Athlete Profile";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-dark-navy text-white p-4 text-center">
                    <h3 class="fw-bold mb-1">Athlete Profile</h3>
                    <p class="text-white-50 small mb-0">Manage personal details and profile picture stored in Azure Blob Storage</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 mb-4">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="UserId" />

                        <!-- Profile Picture Display and Upload (Requirement 4 & 5) -->
                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block">
                                <div class="rounded-circle overflow-hidden shadow-lg border border-3 border-success mx-auto" style="width: 120px; height: 120px; background-color: #0f172a;">
                                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                    {
                                        <img src="@Model.ProfilePictureUrl" alt="Profile" class="w-100 h-100 object-fit-cover" onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80'" />
                                    }
                                    else
                                    {
                                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80" alt="Default Avatar" class="w-100 h-100 object-fit-cover opacity-90" />
                                    }
                                </div>
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-info text-dark small"><i class="bi bi-cloud-check-fill me-1"></i>Azure Blob: profile-pictures</span>
                            </div>
                        </div>

                        <div class="card bg-light border-0 p-3 rounded-3 mb-4">
                            <label asp-for="ProfilePictureFile" class="form-label fw-bold small text-secondary">Upload New Profile Picture</label>
                            <input asp-for="ProfilePictureFile" class="form-control" type="file" accept="image/*" />
                            <small class="text-muted mt-1 d-block">Uploaded directly to Azure Blob Storage container <code>profile-pictures</code> via Part 2 API.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Email" class="form-control" readonly disabled />
                            <small class="text-muted">Email address is managed by the authentication system.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Phone" class="form-control" placeholder="+27 82 000 0000" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow">
                            <i class="bi bi-save me-1"></i> Update Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
