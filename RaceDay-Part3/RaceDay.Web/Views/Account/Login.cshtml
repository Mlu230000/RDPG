@model RaceDay.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark-navy text-white p-4 text-center">
                    <div class="brand-badge bg-gradient-race text-dark d-inline-block rounded-3 px-3 py-1 fw-bold fs-5 mb-2">
                        <i class="bi bi-stopwatch-fill me-1"></i>RACEDAY
                    </div>
                    <h4 class="fw-bold mb-1">Welcome Back</h4>
                    <p class="text-white-50 small mb-0">Sign in to manage events or track your race entries</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 shadow-sm mb-3">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-action="Login" method="post" asp-route-returnUrl="@ViewBag.ReturnUrl">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="athlete@example.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>

                    <!-- Quick Demo Credentials Box for Evaluation -->
                    <div class="card bg-light border-0 mt-4 p-3 rounded-3 small">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-key-fill text-warning me-1"></i>Demo Accounts for Grading:</div>
                        <div class="text-muted d-flex flex-column gap-1">
                            <div><strong>Organiser:</strong> <code>sipho@raceday.co.za</code> / <code>Password123!</code></div>
                            <div><strong>Participant:</strong> <code>thandi@runner.co.za</code> / <code>Password123!</code></div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <span class="text-muted small">New to RaceDay?</span>
                        <a asp-action="Register" class="fw-bold text-success text-decoration-none small ms-1">Create an Account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
