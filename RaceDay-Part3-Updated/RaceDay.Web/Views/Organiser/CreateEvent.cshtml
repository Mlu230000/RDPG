@model RaceDay.Web.Models.CreateEventViewModel
@{
    ViewData["Title"] = "Create Sports Event";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark-navy text-white p-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success px-2 py-1"><i class="bi bi-flag-fill me-1"></i>New Event</span>
                    </div>
                    <h3 class="fw-bold mb-1 mt-2">Create New Event</h3>
                    <p class="text-white-50 small mb-0">Fill in all required fields and upload an event banner to Azure Blob Storage.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 mb-4">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="EventName" class="form-control form-control-lg" placeholder="e.g. Comrades Marathon 2026, Soweto 10k..." />
                            <span asp-validation-for="EventName" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold small text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide event details, route highlights, water tables, medal awards..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Date & Time -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EventDate" class="form-label fw-bold small text-secondary"></label>
                                <input asp-for="EventDate" class="form-control" />
                                <span asp-validation-for="EventDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label fw-bold small text-secondary"></label>
                                <input asp-for="StartTime" class="form-control" placeholder="06:00" />
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Location & Province -->
                        <div class="row mb-3">
                            <div class="col-md-7">
                                <label asp-for="Location" class="form-label fw-bold small text-secondary"></label>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Durban City Hall to Pietermaritzburg" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Province" class="form-label fw-bold small text-secondary"></label>
                                <select asp-for="Province" class="form-select">
                                    <option value="Gauteng">Gauteng</option>
                                    <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                    <option value="Western Cape">Western Cape</option>
                                    <option value="Eastern Cape">Eastern Cape</option>
                                    <option value="Mpumalanga">Mpumalanga</option>
                                    <option value="Free State">Free State</option>
                                    <option value="Limpopo">Limpopo</option>
                                    <option value="North West">North West</option>
                                    <option value="Northern Cape">Northern Cape</option>
                                </select>
                            </div>
                        </div>

                        <!-- Event Type & Initial Distance (Required Fields) -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="EventTypeId" class="form-label fw-bold small text-secondary"></label>
                                <select asp-for="EventTypeId" class="form-select">
                                    <option value="1">🏃 Running</option>
                                    <option value="2">🚴 Cycling</option>
                                    <option value="3">🚶 Walking</option>
                                </select>
                                <span asp-validation-for="EventTypeId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InitialDistanceKm" class="form-label fw-bold small text-secondary"></label>
                                <div class="input-group">
                                    <input asp-for="InitialDistanceKm" class="form-control" placeholder="10.0" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span asp-validation-for="InitialDistanceKm" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Azure Blob Storage Event Banner Image (Requirement 3 & 5) -->
                        <div class="card border border-2 border-dashed rounded-3 p-3 mb-4 bg-light">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-cloud-arrow-up-fill fs-4 text-primary"></i>
                                <label asp-for="BannerFile" class="form-label fw-bold mb-0 text-dark">
                                    Upload Event Banner Image (Azure Blob Storage)
                                </label>
                            </div>
                            <input asp-for="BannerFile" class="form-control" type="file" accept="image/*" />
                            <small class="text-muted mt-1 d-block">
                                Accepted formats: JPG, PNG, WEBP (Max 10MB). Stored directly in Azure Blob container <code>event-banners</code> through the REST API.
                            </small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold px-5 shadow">
                                <i class="bi bi-check-lg me-1"></i> Publish Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
